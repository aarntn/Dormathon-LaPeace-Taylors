SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Publishable key (or legacy anon key). User JWTs enforce RLS; no service-role key is needed.
SUPABASE_PUBLISHABLE_KEY=
GEOCODE_URL=https://nominatim.openstreetmap.org/search
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Exact origins that may call the API from a browser. Not needed when the app is served by this service.
CORS_ORIGINS=https://localhost:5173,https://YOUR_FRONTEND.example

# Presentation mode. 1 makes the dashboard scan and start-up check return scripted, labelled demo results
# (chosen in the hidden demo panel). Leave empty otherwise: a dashboard photo then finds nothing.
DEMO_MODE=
